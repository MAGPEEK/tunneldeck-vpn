tunneldeck {
  version = 2
  remote_addrs = [vpn.example.com]
  proposals = [aes256gcm16-aes128gcm16-prfsha384-prfsha256-curve25519-ecp384-ecp256-modp3072-modp2048, aes256-aes128-sha384-sha256-curve25519-ecp384-ecp256-modp3072-modp2048]
  vips = [0.0.0.0]
  encap = yes
  fragmentation = yes
  dpd_delay = 30s
  mobike = no
  rekey_time = 4h
  reauth_time = 0
  keyingtries = 0
  local {
    auth = eap-mschapv2
    eap_id = alice
    id = alice
  }
  remote {
    auth = pubkey
    id = vpn.example.com
    cacerts = [<certificate CN=Test CA>]
    revocation = relaxed
  }
  children {
    tunneldeck {
      local_ts = [dynamic]
      remote_ts = [0.0.0.0/0]
      esp_proposals = [aes256gcm16-aes128gcm16-chacha20poly1305-curve25519-ecp256-modp3072-modp2048, aes256-aes128-sha256-curve25519-ecp256-modp3072-modp2048, aes256gcm16-aes128gcm16-chacha20poly1305, aes256-aes128-sha256]
      rekey_time = 1h
      dpd_action = restart
      close_action = start
      start_action = none
    }
  }
}
