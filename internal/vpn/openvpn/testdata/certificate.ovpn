; certificate and password, TCP
client
dev tun
proto udp
remote vpn.example.com 443 tcp-client
remote backup.example.com 1194 udp
ns-cert-type server
comp-lzo
key-direction 1
auth SHA256
keepalive 10 60
<ca>
<CA PEM>
</ca>
<cert>
<CLIENT CERT PEM>
</cert>
<key>
<CLIENT KEY PEM>
</key>
<tls-auth>
<TLS AUTH KEY>
</tls-auth>
<auth-user-pass>
alice
p "a\ss'w#rd
</auth-user-pass>
<dh>
not imported
</dh>
