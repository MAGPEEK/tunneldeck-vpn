##############################################
# Sample client-side OpenVPN connection profile
# for a cloud VPN service. Synthetic test data.
##############################################
client
dev tun
proto udp
remote region-a.example.net 1194
remote region-a.example.net 443 tcp
resolv-retry infinite
nobind
remote-cert-tls server
tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth SHA256
keepalive 10 60
verb 3
auth-nocache
pull-filter ignore "redirect-gateway"
<ca>
<CA PEM>
</ca>
<cert>
<CLIENT CERT PEM>
</cert>
<key>
<CLIENT KEY PEM>
</key>
<tls-crypt>
<TLS CRYPT KEY>
</tls-crypt>
