# Exported from a RUT240 (mdex public.IP level 20)
client
dev tun
proto udp
remote publicip20.mdex.de 1194
resolv-retry infinite
nobind
persist-key
persist-tun
cipher none
auth none
tun-mtu 1500
fragment 1448
mssfix
float
reneg-sec 86400
remote-cert-tls server
tls-version-min 1.2
explicit-exit-notify 2
fast-io
redirect-gateway def1
auth-user-pass
verb 3
<ca>
<CA PEM>
</ca>
