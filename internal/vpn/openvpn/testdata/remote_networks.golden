# rendered by TunnelDeck-VPN - do not edit
client
dev tdvpn0
dev-type tun
remote 198.51.100.7 1194 udp
resolv-retry infinite
nobind
persist-tun
disable-dco

# server verification
remote-cert-tls server
<ca>
<CA PEM>
</ca>

# credentials over management, never in this file
auth-user-pass
auth-retry none

# extra options
tls-version-min 1.2

# routing is owned by TunnelDeck-VPN
route-noexec
route-nopull
pull-filter ignore "ifconfig-ipv6"

# management
management /run/tunneldeck/mgmt.sock unix
management-hold
management-query-passwords
verb 3
