#####################################################################
# Synthetic client profile shaped like mdex fixed.IP level 30 (router).
# Same directives as the provider file; the CA is generated by the test.
#####################################################################

client
pull
tls-client
auth none
dev tun
remote openvpn30.mdex.de 1194 udp
resolv-retry infinite
verb 5
data-ciphers CHACHA20-POLY1305:AES-256-GCM
nobind
float
remote-cert-tls server
tls-version-min 1.3
explicit-exit-notify 2
script-security 2
<ca>
<CA PEM>
</ca>

# Optional: enter the account data below
# and remove all semicolons (;):

;<auth-user-pass>
;Username
;Password
;</auth-user-pass>
