kernel-libipsec: honour charon.install_routes

kernel-libipsec installs a route through its TUN device for every outbound
policy, ignoring charon.install_routes. With routing_table = 0 these routes
land in the main table (0.0.0.0/0 split into two /1 routes), otherwise
kernel-netlink adds a routing rule for its own table; both change the
host's routing, which TunnelDeck-VPN never does (SPEC §6, §19). With this
patch install_routes = no keeps kernel-libipsec from installing routes;
TunnelDeck routes through the tunnel device itself (table 7194).

--- a/src/libcharon/plugins/kernel_libipsec/kernel_libipsec_ipsec.c
+++ b/src/libcharon/plugins/kernel_libipsec/kernel_libipsec_ipsec.c
@@ -61,6 +61,11 @@
 	 * Whether UDP encapsulation is required
 	 */
 	bool require_encap;
+
+	/**
+	 * Whether to install routes via the TUN device (charon.install_routes)
+	 */
+	bool install_routes;
 };
 
 typedef struct exclude_route_t exclude_route_t;
@@ -410,7 +415,7 @@
 	host_t *src_ip;
 	bool is_virtual;
 
-	if (policy->direction != POLICY_OUT)
+	if (policy->direction != POLICY_OUT || !this->install_routes)
 	{
 		this->mutex->unlock(this->mutex);
 		return TRUE;
@@ -717,6 +722,8 @@
 		.allow_peer_ts = lib->settings->get_bool(lib->settings,
 					"%s.plugins.kernel-libipsec.allow_peer_ts", FALSE, lib->ns),
 		.require_encap = !lib->get(lib, "kernel-libipsec-esp-handler"),
+		.install_routes = lib->settings->get_bool(lib->settings,
+					"%s.install_routes", TRUE, lib->ns),
 	);
 
 	ipsec->events->register_listener(ipsec->events, &this->ipsec_listener);
